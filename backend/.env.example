# Copy this file to .env.local for local development.
# Replace every placeholder value before running the application.

SPRING_PROFILES_ACTIVE=local

IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/dating_app?options=-c%20TimeZone%3DUTC
IDENTITY_DB_USERNAME=dating_user
IDENTITY_DB_PASSWORD=replace-with-local-database-password

IDENTITY_JPA_SHOW_SQL=true
IDENTITY_JPA_FORMAT_SQL=true

IDENTITY_JWT_KEY_ID=local-development-key
IDENTITY_JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nreplace-with-local-private-key\n-----END PRIVATE KEY-----"
IDENTITY_JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nreplace-with-local-public-key\n-----END PUBLIC KEY-----"
IDENTITY_JWT_ISSUER=identity-service
IDENTITY_JWT_AUDIENCE=dating-app

IDENTITY_OTP_HMAC_SECRET=replace-with-local-otp-hmac-secret
IDENTITY_PHONE_HMAC_SECRET=replace-with-local-phone-hmac-secret
IDENTITY_REFRESH_TOKEN_HMAC_SECRET=replace-with-local-refresh-token-hmac-secret
IDENTITY_ACCESS_TOKEN_TTL=PT15M
IDENTITY_REFRESH_TOKEN_TTL=P30D

IDENTITY_OTP_LENGTH=6
IDENTITY_OTP_TTL=PT5M
IDENTITY_OTP_RESEND_COOLDOWN=PT60S
IDENTITY_OTP_REQUEST_LIMIT=5
IDENTITY_OTP_REQUEST_LIMIT_WINDOW=PT15M
IDENTITY_OTP_MAX_VERIFICATION_ATTEMPTS=5
IDENTITY_OTP_DELIVERY_PROVIDER=local

IDENTITY_SERVICE_PORT=8080
