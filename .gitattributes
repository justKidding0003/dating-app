# Auto detect text files
* text=auto

# Java
*.java text eol=lf

# Kotlin
*.kt text eol=lf

# Gradle
*.gradle text eol=lf

# Maven
*.xml text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# PlantUML
*.puml text eol=lf

# Shell
*.sh text eol=lf

# PowerShell
*.ps1 text eol=crlf

# Windows batch
*.bat text eol=crlf
*.cmd text eol=crlf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.svg text